{
  "name": "@learnv/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Optional LearnV account and synchronisation API (Express 5, PostgreSQL).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@learnv/schemas": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.2"
  }
}
