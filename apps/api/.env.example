# Copy to apps/api/.env for `pnpm api:dev`, or to the repository root .env for `docker compose`.
# Never commit the real file.

# Production: postgres://user:password@host:5432/learnv. Empty in development: embedded PGlite in apps/api/.data.
DATABASE_URL=
# docker compose only: password of the bundled PostgreSQL.
POSTGRES_PASSWORD=
# 32 random bytes, base64: openssl rand -base64 32. Losing it makes stored documents unreadable.
DATA_KEY=
# Public address of the web app, with base path and trailing slash. Magic links point here.
PUBLIC_APP_URL=http://localhost:5173/
# console (development: links are printed in the log) or smtp.
MAIL_TRANSPORT=console
# smtp://user:password@smtp.example.com:587 or smtps://...:465
SMTP_URL=
MAIL_FROM="LearnV <no-reply@example.com>"
# Optional extra origins allowed to call the API with credentials (split deployments), comma-separated.
CORS_ORIGINS=
# Reverse proxies in front of the API (Nginx in compose = 1).
TRUST_PROXY=1
# Defaults: sessions 30 days, sign-in links 15 minutes, idle accounts deleted after 730 days.
SESSION_DAYS=30
LOGIN_TOKEN_MINUTES=15
RETENTION_DAYS=730
PORT=3001
