{
  "name": "learnv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:qa": "vite --mode qa",
    "build:qa": "tsc -b && vite build --mode qa && node scripts/create-spa-fallback.mjs && node scripts/check-startup-budget.mjs && node scripts/csp.mjs dist && node scripts/strip-sourcemaps.mjs dist",
    "build": "tsc -b && vite build && node scripts/create-spa-fallback.mjs && node scripts/check-startup-budget.mjs && node scripts/csp.mjs dist && node scripts/strip-sourcemaps.mjs dist",
    "gks:update": "node scripts/update-gks-radar.mjs",
    "art:optimize": "svgo --config svgo.config.mjs --folder public/illustrations/learning-path",
    "library:check-links": "node --experimental-strip-types scripts/check-reading-library.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "node scripts/preview-pages.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "e2e": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:commits": "node scripts/check-release-commits.mjs",
    "validate": "pnpm run check:architecture && pnpm run lint && pnpm test && pnpm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "svgo": "4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
